# ============================================
# 📧 MedCloud — Email Configuration
# ============================================
# Choose your email provider: emailjs | smtp | sendgrid | mailgun | resend
EMAIL_PROVIDER=emailjs

# ── EmailJS (recommended for frontend-only) ──
# Sign up at https://www.emailjs.com/ to get your keys
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key_here

# ── SMTP (requires backend server) ──
# Supported: Gmail, Outlook, or any SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@medcloud.com
SMTP_SECURE=false

# ── SendGrid ──
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# ── Mailgun ──
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_domain.com

# ── Resend ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# ── Backend (for SMTP mode) ──
BACKEND_URL=http://localhost:3000
